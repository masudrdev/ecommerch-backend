Auth APIs
Register
POST /api/auth/register
{
  "name": "Customer User",
  "username": "customer1",
  "email": "customer@gmail.com",
  "password": "123456",
  "role": "CUSTOMER"
}
Vendor Register Account
POST /api/auth/register
{
  "name": "Vendor User",
  "username": "vendor1",
  "email": "vendor@gmail.com",
  "password": "123456",
  "role": "VENDOR"
}
Verify Email
POST /api/auth/verify-email
{
  "email": "customer@gmail.com",
  "code": "123456"
}
Login
POST /api/auth/login
{
  "emailOrUsername": "customer1",
  "password": "123456"
}
Vendor APIs
Create Vendor Shop
POST /api/vendors/register
Authorization: Bearer VENDOR_TOKEN
{
  "shopName": "Friend Shop",
  "shopSlug": "friend-shop",
  "description": "Best products shop"
}
Approve Vendor
PATCH /api/vendors/VENDOR_ID/status
Authorization: Bearer ADMIN_TOKEN
{
  "status": "APPROVED"
}
Category APIs
Create Category
POST /api/categories
Authorization: Bearer ADMIN_TOKEN
{
  "name": "Fashion",
  "slug": "fashion"
}
Create Sub Category
POST /api/categories
Authorization: Bearer ADMIN_TOKEN
{
  "name": "Women",
  "slug": "women",
  "parentId": "CATEGORY_ID"
}
Brand APIs
Create Brand
POST /api/brands
Authorization: Bearer ADMIN_TOKEN
{
  "name": "No Brand",
  "slug": "no-brand"
}
Product APIs
Create Product
POST /api/products
Authorization: Bearer VENDOR_TOKEN
{
  "name": "Cotton Three Piece",
  "slug": "cotton-three-piece",
  "description": "Comfortable cotton three piece",
  "price": 1200,
  "salePrice": 999,
  "stock": 20,
  "categoryId": "CATEGORY_ID",
  "brandId": "BRAND_ID"
}
Approve Product
PATCH /api/products/PRODUCT_ID/status
Authorization: Bearer ADMIN_TOKEN
{
  "status": "APPROVED"
}
Add Product Variants
POST /api/products/PRODUCT_ID/variants
Authorization: Bearer VENDOR_TOKEN
{
  "variants": [
    {
      "size": "M",
      "color": "Black",
      "stock": 10,
      "price": 999
    },
    {
      "size": "L",
      "color": "Black",
      "stock": 15,
      "price": 999
    }
  ]
}
Update Product
PATCH /api/products/PRODUCT_ID
Authorization: Bearer VENDOR_TOKEN
{
  "name": "Updated Cotton Three Piece",
  "price": 1500,
  "stock": 50
}
Product Image Upload
POST /api/products/PRODUCT_ID/images
Authorization: Bearer VENDOR_TOKEN
Body: form-data
Key: images
Type: File
Wishlist APIs
Add Wishlist
POST /api/wishlist/PRODUCT_ID
Authorization: Bearer CUSTOMER_TOKEN

No JSON body.

Remove Wishlist
DELETE /api/wishlist/PRODUCT_ID
Authorization: Bearer CUSTOMER_TOKEN
Cart APIs
Add To Cart
POST /api/cart
Authorization: Bearer CUSTOMER_TOKEN
{
  "productId": "PRODUCT_ID",
  "quantity": 2,
  "size": "M",
  "color": "Black"
}
Update Cart Item
PATCH /api/cart/CART_ITEM_ID
Authorization: Bearer CUSTOMER_TOKEN
{
  "quantity": 3
}
Order APIs
Checkout Order
POST /api/orders/checkout
Authorization: Bearer CUSTOMER_TOKEN
{
  "customerName": "Joya",
  "phone": "01700000000",
  "address": "Mirzapur, Tangail",
  "district": "Tangail",
  "upazila": "Mirzapur",
  "deliveryFee": 100
}
Admin Manual Order
POST /api/orders/manual
Authorization: Bearer ADMIN_TOKEN
{
  "customerId": "CUSTOMER_USER_ID",
  "customerName": "Joya",
  "phone": "01700000000",
  "address": "Mirzapur, Tangail",
  "district": "Tangail",
  "upazila": "Mirzapur",
  "deliveryFee": 100,
  "items": [
    {
      "productId": "PRODUCT_ID",
      "quantity": 2,
      "size": "M",
      "color": "Black"
    }
  ]
}
Update Order Status
PATCH /api/orders/ORDER_ID/status
Authorization: Bearer ADMIN_TOKEN
{
  "orderStatus": "CONFIRMED"
}
COD Paid + Completed
PATCH /api/orders/ORDER_ID/status
Authorization: Bearer ADMIN_TOKEN
{
  "orderStatus": "COMPLETED",
  "paymentStatus": "PAID"
}
Customer Cancel Order
PATCH /api/orders/ORDER_ID/cancel
Authorization: Bearer CUSTOMER_TOKEN

No JSON body.