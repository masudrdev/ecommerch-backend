generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                        String            @id @default(uuid())
  name                      String
  email                     String            @unique
  phone                     String?
  password                  String
  role                      Role              @default(CUSTOMER)
  status                    UserStatus        @default(ACTIVE)
  isEmailVerified           Boolean           @default(false)
  emailVerificationCode     String?
  emailVerificationExpires  DateTime?
  avatar                    String?
  createdAt                 DateTime          @default(now())
  updatedAt                 DateTime          @updatedAt
  username                  String            @unique
  resetPasswordCode         String?
  resetPasswordExpires      DateTime?
  refreshToken              String?
  activityLogs              ActivityLog[]
  cart                      Cart?
  notifications             Notification[]
  createdOrders             Order[]           @relation("OrderCreatedBy")
  orders                    Order[]
  orderNotes                OrderNote[]
  orderTimelines            OrderTimeline[]
  approvedProducts          Product[]         @relation("ProductApprovedBy")
  products                  Product[]
  reviews                   Review[]
  supportTicketsCreated     SupportTicket[]   @relation("SupportTicketCreatedBy")
  supportTicketsAssigned    SupportTicket[]   @relation("SupportTicketAssignedTo")
  supportTicketsEscalatedBy SupportTicket[]   @relation("SupportTicketEscalatedBy")
  supportTicketsEscalatedTo SupportTicket[]   @relation("SupportTicketEscalatedTo")
  supportMessages           SupportMessage[]
  supportActivities         SupportActivity[]
  addresses                 UserAddress[]
  vendor                    Vendor?
  wishlists                 Wishlist[]
}

model OrderTimeline {
  id        String     @id @default(uuid())
  orderId   String
  itemId    String?
  userId    String
  title     String
  details   String?
  type      String     @default("INFO")
  createdAt DateTime   @default(now())
  item      OrderItem? @relation(fields: [itemId], references: [id])
  order     Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id])
}

model UserAddress {
  id        String      @id @default(uuid())
  userId    String
  type      AddressType @default(HOME)
  fullName  String
  phone     String
  address   String
  district  String
  upazila   String
  isDefault Boolean     @default(false)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model SupportTicket {
  id           String  @id @default(uuid())
  ticketNumber String? @unique

  userId String
  user   User   @relation("SupportTicketCreatedBy", fields: [userId], references: [id], onDelete: Cascade)

  subject     String
  description String?
  category    String?
  priority    TicketPriority @default(MEDIUM)
  status      TicketStatus   @default(OPEN)

  orderId String?

  assignedToId String?
  assignedTo   User?   @relation("SupportTicketAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)

  escalatedById String?
  escalatedBy   User?   @relation("SupportTicketEscalatedBy", fields: [escalatedById], references: [id], onDelete: SetNull)

  escalatedToId String?
  escalatedTo   User?   @relation("SupportTicketEscalatedTo", fields: [escalatedToId], references: [id], onDelete: SetNull)

  escalationReason  String?
  resolutionSummary String?

  firstResponseAt DateTime?
  resolvedAt      DateTime?
  closedAt        DateTime?
  lastActivityAt  DateTime  @default(now())

  customerRating   Int?
  customerFeedback String?

  isArchived Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages    SupportMessage[]
  attachments SupportAttachment[]
  activities  SupportActivity[]

  @@index([userId])
  @@index([assignedToId])
  @@index([escalatedToId])
  @@index([status])
  @@index([priority])
  @@index([category])
  @@index([createdAt])
  @@index([lastActivityAt])
}

model SupportMessage {
  id       String @id @default(uuid())
  ticketId String
  senderId String

  message    String
  isInternal Boolean @default(false)
  isEdited   Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  sender User          @relation(fields: [senderId], references: [id], onDelete: Cascade)
  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  attachments SupportAttachment[]

  @@index([ticketId])
  @@index([senderId])
  @@index([createdAt])
}

model SupportAttachment {
  id String @id @default(uuid())

  ticketId  String
  messageId String?

  fileName String
  fileUrl  String
  fileType String?
  fileSize Int?

  isSensitive Boolean @default(false)

  createdAt DateTime @default(now())

  ticket  SupportTicket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  message SupportMessage? @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@index([messageId])
}

model SupportActivity {
  id String @id @default(uuid())

  ticketId String
  userId   String?

  action   SupportActivityType
  details  String?
  oldValue String?
  newValue String?

  createdAt DateTime @default(now())

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user   User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([ticketId])
  @@index([userId])
  @@index([createdAt])
}

model Vendor {
  id                     String          @id @default(uuid())
  userId                 String          @unique
  shopName               String
  shopSlug               String          @unique
  shopLogo               String?
  shopBanner             String?
  description            String?
  status                 VendorStatus    @default(PENDING)
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt
  availableBalance       Float           @default(0)
  totalWithdrawn         Float           @default(0)
  defaultCommissionType  CommissionType?
  defaultCommissionValue Float?
  orders                 OrderItem[]
  orderNotes             OrderNote[]
  payouts                PayoutRequest[]
  products               Product[]
  user                   User            @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Category {
  id        String     @id @default(uuid())
  name      String
  slug      String     @unique
  image     String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  parentId  String?
  parent    Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryHierarchy")
  products  Product[]
}

model Brand {
  id        String    @id @default(uuid())
  name      String
  slug      String    @unique
  logo      String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]
}

model Product {
  id                         String           @id @default(uuid())
  name                       String
  slug                       String           @unique
  description                String?
  price                      Float
  salePrice                  Float?
  stock                      Int              @default(0)
  status                     ProductStatus    @default(PENDING)
  vendorId                   String
  userId                     String
  categoryId                 String?
  brandId                    String?
  createdAt                  DateTime         @default(now())
  updatedAt                  DateTime         @updatedAt
  deliveryCharge             Float            @default(0)
  outsideDistrictExtraCharge Float            @default(35)
  approvedAt                 DateTime?
  approvedById               String?
  commissionType             CommissionType?
  commissionValue            Float?
  rejectedAt                 DateTime?
  rejectionReason            String?
  cartItems                  CartItem[]
  orderItems                 OrderItem[]
  approvedBy                 User?            @relation("ProductApprovedBy", fields: [approvedById], references: [id])
  brand                      Brand?           @relation(fields: [brandId], references: [id])
  category                   Category?        @relation(fields: [categoryId], references: [id])
  user                       User             @relation(fields: [userId], references: [id])
  vendor                     Vendor           @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  images                     ProductImage[]
  variants                   ProductVariant[]
  reviews                    Review[]
  wishlists                  Wishlist[]

  @@index([approvedById])
}

model ProductImage {
  id        String  @id @default(uuid())
  productId String
  url       String
  publicId  String?
  isMain    Boolean @default(false)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model ProductVariant {
  id        String  @id @default(uuid())
  productId String
  size      String?
  color     String?
  sku       String?
  stock     Int     @default(0)
  price     Float?
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Cart {
  id        String     @id @default(uuid())
  userId    String     @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
}

model CartItem {
  id        String  @id @default(uuid())
  cartId    String
  productId String
  quantity  Int     @default(1)
  size      String?
  color     String?
  cart      Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id])
}

model Order {
  id            String          @id @default(uuid())
  orderNumber   String          @unique
  userId        String
  totalAmount   Float
  deliveryFee   Float           @default(0)
  paymentMethod PaymentMethod   @default(COD)
  paymentStatus PaymentStatus   @default(UNPAID)
  orderStatus   OrderStatus     @default(PENDING)
  customerName  String
  phone         String
  address       String
  district      String?
  upazila       String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  createdById   String?
  createdByRole Role?
  source        String          @default("CUSTOMER")
  createdBy     User?           @relation("OrderCreatedBy", fields: [createdById], references: [id])
  user          User            @relation(fields: [userId], references: [id])
  items         OrderItem[]
  notes         OrderNote[]
  timelines     OrderTimeline[]
}

model OrderItem {
  id                String          @id @default(uuid())
  orderId           String
  productId         String
  vendorId          String
  quantity          Int
  price             Float
  size              String?
  color             String?
  deliveryCharge    Float           @default(0)
  shippedAt         DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @default(now()) @updatedAt
  stockReduced      Boolean         @default(false)
  itemStatus        OrderItemStatus @default(PENDING)
  commissionAmount  Float?
  commissionType    CommissionType?
  commissionValue   Float?
  platformEarning   Float?
  vendorEarning     Float?
  returnStatus      ReturnStatus    @default(NONE)
  deliveredAt       DateTime?
  completedAt       DateTime?
  returnRequestedAt DateTime?
  returnResolvedAt  DateTime?
  order             Order           @relation(fields: [orderId], references: [id])
  product           Product         @relation(fields: [productId], references: [id])
  vendor            Vendor          @relation(fields: [vendorId], references: [id])
  timelines         OrderTimeline[]
}

model OrderNote {
  id                String   @id @default(uuid())
  orderId           String
  userId            String
  vendorId          String?
  note              String
  noteType          String   @default("VENDOR_INTERNAL")
  visibleToCustomer Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  order             Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user              User     @relation(fields: [userId], references: [id])
  vendor            Vendor?  @relation(fields: [vendorId], references: [id])
}

model Wishlist {
  id        String   @id @default(uuid())
  userId    String
  productId String
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
}

model Review {
  id              String    @id @default(uuid())
  userId          String?
  productId       String
  rating          Int
  comment         String?
  createdAt       DateTime  @default(now())
  vendorRepliedAt DateTime?
  vendorReply     String?
  reviewerAvatar  String?
  reviewerName    String?
  source          String    @default("USER")
  product         Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  user            User?     @relation(fields: [userId], references: [id])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  message   String
  type      String
  isRead    Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ActivityLog {
  id         String   @id @default(uuid())
  userId     String?
  action     String
  entityType String?
  entityId   String?
  oldData    Json?
  newData    Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())
  user       User?    @relation(fields: [userId], references: [id])
}

model PayoutRequest {
  id        String   @id @default(uuid())
  vendorId  String
  amount    Float
  status    String   @default("PENDING")
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  vendor    Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
}

model PlatformSetting {
  id                     String         @id @default("GLOBAL")
  defaultCommissionType  CommissionType @default(PERCENTAGE)
  defaultCommissionValue Float          @default(0)
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt
}

enum Role {
  SUPER_ADMIN
  ADMIN
  SUPPORT_AGENT
  VENDOR
  CUSTOMER
}

enum UserStatus {
  ACTIVE
  PENDING
  BLOCKED
}

enum VendorStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum ProductStatus {
  PENDING
  APPROVED
  REJECTED
  DRAFT
}

enum CommissionType {
  PERCENTAGE
  FIXED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  COMPLETED
  CANCELLED
  RETURNED
  REFUNDED
  PARTIALLY_CONFIRMED
  PARTIALLY_PROCESSING
  PARTIALLY_SHIPPED
  PARTIALLY_DELIVERED
  PARTIALLY_COMPLETED
  PARTIALLY_CANCELLED
}

enum OrderItemStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  CANCELLED
  DELIVERED
  COMPLETED
  RESHIPPED
}

enum ReturnStatus {
  NONE
  REQUESTED
  APPROVED
  REJECTED
  IN_TRANSIT
  RECEIVED
  RESHIPPED
  RESOLVED
}

enum PaymentMethod {
  COD
}

enum PaymentStatus {
  UNPAID
  PAID
}

enum TicketStatus {
  OPEN
  PENDING
  IN_PROGRESS
  WAITING_FOR_CUSTOMER
  WAITING_FOR_STAFF
  ESCALATED
  RESOLVED
  CLOSED
  REJECTED
}

enum TicketCategory {
  ORDER_ISSUE
  PAYMENT_ISSUE
  REFUND_REQUEST
  WITHDRAWAL_ISSUE
  ACCOUNT_ISSUE
  PRODUCT_ISSUE
  DELIVERY_ISSUE
  TECHNICAL_ISSUE
  VENDOR_ISSUE
  OTHER
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum SupportActivityType {
  TICKET_CREATED
  REPLY_ADDED
  INTERNAL_NOTE_ADDED
  ASSIGNED
  REASSIGNED
  PRIORITY_CHANGED
  STATUS_CHANGED
  ESCALATED
  RESOLVED
  CLOSED
  REOPENED
  REJECTED
  ATTACHMENT_ADDED
  RATING_ADDED
  ARCHIVED
}

enum AddressType {
  HOME
  OFFICE
  OTHER
}
