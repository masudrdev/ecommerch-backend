generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                        String               @id @default(uuid())
  name                      String
  email                     String               @unique
  phone                     String?              @unique
  password                  String
  role                      Role                 @default(CUSTOMER)
  status                    UserStatus           @default(ACTIVE)
  isEmailVerified           Boolean              @default(false)
  emailVerificationCode     String?
  emailVerificationExpires  DateTime?
  avatar                    String?
  createdAt                 DateTime             @default(now())
  updatedAt                 DateTime             @updatedAt
  username                  String               @unique
  resetPasswordCode         String?
  resetPasswordExpires      DateTime?
  refreshToken              String?
  activityLogs              ActivityLog[]
  cart                      Cart?
  financeTransactions       FinanceTransaction[]
  notifications             Notification[]
  createdOrders             Order[]              @relation("OrderCreatedBy")
  orders                    Order[]
  orderNotes                OrderNote[]
  orderTimelines            OrderTimeline[]
  approvedProducts          Product[]            @relation("ProductApprovedBy")
  products                  Product[]
  reviews                   Review[]
  supportActivities         SupportActivity[]
  supportMessages           SupportMessage[]
  supportTicketsAssigned    SupportTicket[]      @relation("SupportTicketAssignedTo")
  supportTicketsEscalatedBy SupportTicket[]      @relation("SupportTicketEscalatedBy")
  supportTicketsEscalatedTo SupportTicket[]      @relation("SupportTicketEscalatedTo")
  supportTicketsCreated     SupportTicket[]      @relation("SupportTicketCreatedBy")
  addresses                 UserAddress[]
  vendor                    Vendor?
  wishlists                 Wishlist[]
  staffContactChange        StaffContactChange?
}

model StaffContactChange {
  id                     String               @id @default(uuid())
  userId                 String               @unique
  purpose                ContactChangePurpose
  codeHash               String
  expiresAt              DateTime
  attempts               Int                  @default(0)
  lastSentAt             DateTime
  authorizationHash      String?
  authorizationExpiresAt DateTime?
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt
  user                   User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}

model OrderTimeline {
  id        String     @id @default(uuid())
  orderId   String
  itemId    String?
  userId    String
  title     String
  details   String?
  type      String     @default("INFO")
  createdAt DateTime   @default(now())
  item      OrderItem? @relation(fields: [itemId], references: [id])
  order     Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id])
}

model UserAddress {
  id        String      @id @default(uuid())
  userId    String
  type      AddressType @default(HOME)
  fullName  String
  phone     String
  address   String
  district  String
  upazila   String
  isDefault Boolean     @default(false)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model SupportTicket {
  id                   String              @id @default(uuid())
  userId               String
  subject              String
  category             String?
  status               TicketStatus        @default(OPEN)
  orderId              String?
  productId            String?
  paymentTransactionId String?
  withdrawalId         String?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  assignedToId         String?
  closedAt             DateTime?
  customerFeedback     String?
  customerRating       Int?
  description          String?
  escalatedById        String?
  escalatedToId        String?
  escalationReason     String?
  firstResponseAt      DateTime?
  isArchived           Boolean             @default(false)
  lastActivityAt       DateTime            @default(now())
  priority             TicketPriority      @default(MEDIUM)
  resolutionSummary    String?
  resolvedAt           DateTime?
  ticketNumber         String?             @unique
  activities           SupportActivity[]
  attachments          SupportAttachment[]
  messages             SupportMessage[]
  assignedTo           User?               @relation("SupportTicketAssignedTo", fields: [assignedToId], references: [id])
  escalatedBy          User?               @relation("SupportTicketEscalatedBy", fields: [escalatedById], references: [id])
  escalatedTo          User?               @relation("SupportTicketEscalatedTo", fields: [escalatedToId], references: [id])
  user                 User                @relation("SupportTicketCreatedBy", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([assignedToId])
  @@index([escalatedToId])
  @@index([status])
  @@index([priority])
  @@index([category])
  @@index([orderId])
  @@index([productId])
  @@index([paymentTransactionId])
  @@index([withdrawalId])
  @@index([createdAt])
  @@index([lastActivityAt])
}

model SupportMessage {
  id          String              @id @default(uuid())
  ticketId    String
  senderId    String
  message     String
  createdAt   DateTime            @default(now())
  isEdited    Boolean             @default(false)
  isInternal  Boolean             @default(false)
  updatedAt   DateTime            @default(now()) @updatedAt
  attachments SupportAttachment[]
  sender      User                @relation(fields: [senderId], references: [id], onDelete: Cascade)
  ticket      SupportTicket       @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@index([senderId])
  @@index([createdAt])
}

model SupportAttachment {
  id          String          @id @default(uuid())
  ticketId    String
  messageId   String?
  fileName    String
  fileUrl     String
  fileType    String?
  fileSize    Int?
  isSensitive Boolean         @default(false)
  createdAt   DateTime        @default(now())
  message     SupportMessage? @relation(fields: [messageId], references: [id], onDelete: Cascade)
  ticket      SupportTicket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@index([messageId])
}

model SupportActivity {
  id        String              @id @default(uuid())
  ticketId  String
  userId    String?
  action    SupportActivityType
  details   String?
  oldValue  String?
  newValue  String?
  createdAt DateTime            @default(now())
  ticket    SupportTicket       @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user      User?               @relation(fields: [userId], references: [id])

  @@index([ticketId])
  @@index([userId])
  @@index([createdAt])
}

model Vendor {
  id                             String               @id @default(uuid())
  userId                         String               @unique
  shopName                       String
  shopSlug                       String               @unique
  shopLogo                       String?
  officeAddress                  String?
  officeDistrict                 String?
  officeUpazila                  String?
  officeVillage                  String?
  pendingEmail                   String?
  pendingPhone                   String?
  contactChangeCode              String?
  contactChangeExpiresAt         DateTime?
  contactChangeAttempts          Int                  @default(0)
  contactChangeLastSentAt        DateTime?
  shopBanner                     String?
  description                    String?
  status                         VendorStatus         @default(PENDING)
  createdAt                      DateTime             @default(now())
  updatedAt                      DateTime             @updatedAt
  availableBalance               Float                @default(0)
  totalWithdrawn                 Float                @default(0)
  defaultCommissionType          CommissionType?
  defaultCommissionValue         Float?
  defaultCommissionActive        Boolean              @default(true)
  defaultCommissionEffectiveFrom DateTime?
  financeTransactions            FinanceTransaction[]
  orders                         OrderItem[]
  orderNotes                     OrderNote[]
  payouts                        PayoutRequest[]
  products                       Product[]
  user                           User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Category {
  id        String     @id @default(uuid())
  name      String
  slug      String     @unique
  image     String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  parentId  String?
  parent    Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryHierarchy")
  products  Product[]
}

model Brand {
  id        String    @id @default(uuid())
  name      String
  slug      String    @unique
  logo      String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]
}

model Product {
  id                         String           @id @default(uuid())
  name                       String
  slug                       String           @unique
  description                String?
  price                      Float
  salePrice                  Float?
  isFeatured                 Boolean          @default(false)
  flashSaleStart             DateTime?
  flashSaleEnd               DateTime?
  stock                      Int              @default(0)
  status                     ProductStatus    @default(PENDING)
  vendorId                   String
  userId                     String
  categoryId                 String?
  brandId                    String?
  createdAt                  DateTime         @default(now())
  updatedAt                  DateTime         @updatedAt
  archivedAt                 DateTime?
  deliveryCharge             Float            @default(0)
  outsideDistrictExtraCharge Float            @default(35)
  approvedAt                 DateTime?
  approvedById               String?
  commissionType             CommissionType?
  commissionValue            Float?
  rejectedAt                 DateTime?
  rejectionReason            String?
  cartItems                  CartItem[]
  orderItems                 OrderItem[]
  approvedBy                 User?            @relation("ProductApprovedBy", fields: [approvedById], references: [id])
  brand                      Brand?           @relation(fields: [brandId], references: [id])
  category                   Category?        @relation(fields: [categoryId], references: [id])
  user                       User             @relation(fields: [userId], references: [id])
  vendor                     Vendor           @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  images                     ProductImage[]
  variants                   ProductVariant[]
  reviews                    Review[]
  wishlists                  Wishlist[]

  @@index([approvedById])
  @@index([archivedAt])
}

model ProductImage {
  id        String  @id @default(uuid())
  productId String
  url       String
  publicId  String?
  isMain    Boolean @default(false)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model ProductVariant {
  id        String  @id @default(uuid())
  productId String
  size      String?
  color     String?
  sku       String?
  stock     Int     @default(0)
  price     Float?
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Cart {
  id        String     @id @default(uuid())
  userId    String     @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
}

model CartItem {
  id        String  @id @default(uuid())
  cartId    String
  productId String
  quantity  Int     @default(1)
  size      String?
  color     String?
  cart      Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id])
}

model Order {
  id            String          @id @default(uuid())
  orderNumber   String          @unique
  userId        String
  totalAmount   Float
  deliveryFee   Float           @default(0)
  paymentMethod PaymentMethod   @default(COD)
  paymentStatus PaymentStatus   @default(UNPAID)
  orderStatus   OrderStatus     @default(PENDING)
  customerName  String
  phone         String
  address       String
  district      String?
  upazila       String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  createdById   String?
  createdByRole Role?
  source        String          @default("CUSTOMER")
  createdBy     User?           @relation("OrderCreatedBy", fields: [createdById], references: [id])
  user          User            @relation(fields: [userId], references: [id])
  items         OrderItem[]
  notes         OrderNote[]
  timelines     OrderTimeline[]
}

model OrderItem {
  id                String          @id @default(uuid())
  orderId           String
  productId         String
  vendorId          String
  quantity          Int
  price             Float
  size              String?
  color             String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @default(now()) @updatedAt
  stockReduced      Boolean         @default(false)
  itemStatus        OrderItemStatus @default(PENDING)
  commissionAmount  Float?
  commissionType    CommissionType?
  commissionValue   Float?
  platformEarning   Float?
  vendorEarning     Float?
  returnStatus      ReturnStatus    @default(NONE)
  deliveredAt       DateTime?
  completedAt       DateTime?
  returnRequestedAt DateTime?
  returnResolvedAt  DateTime?
  deliveryCharge    Float           @default(0)
  deliveryType      String?
  shippedAt         DateTime?
  order             Order           @relation(fields: [orderId], references: [id])
  product           Product         @relation(fields: [productId], references: [id])
  vendor            Vendor          @relation(fields: [vendorId], references: [id])
  timelines         OrderTimeline[]
}

model OrderNote {
  id                String   @id @default(uuid())
  orderId           String
  userId            String
  vendorId          String?
  note              String
  noteType          String   @default("VENDOR_INTERNAL")
  visibleToCustomer Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  order             Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user              User     @relation(fields: [userId], references: [id])
  vendor            Vendor?  @relation(fields: [vendorId], references: [id])
}

model Wishlist {
  id        String   @id @default(uuid())
  userId    String
  productId String
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
}

model Review {
  id              String        @id @default(uuid())
  userId          String?
  productId       String
  rating          Int
  comment         String?
  createdAt       DateTime      @default(now())
  vendorRepliedAt DateTime?
  vendorReply     String?
  reviewerAvatar  String?
  reviewerName    String?
  source          String        @default("USER")
  product         Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  user            User?         @relation(fields: [userId], references: [id])
  images          ReviewImage[]
}

model ReviewImage {
  id        String   @id @default(uuid())
  reviewId  String
  url       String
  publicId  String
  createdAt DateTime @default(now())
  review    Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@index([reviewId])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  message   String
  type      String
  isRead    Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ActivityLog {
  id          String   @id @default(uuid())
  userId      String?
  action      String
  entityType  String?
  entityId    String?
  module      String?
  targetName  String?
  status      String   @default("SUCCESS")
  description String?
  oldData     Json?
  newData     Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([createdAt])
  @@index([userId])
  @@index([module])
  @@index([action])
  @@index([status])
}

model PayoutRequest {
  id              String       @id @default(uuid())
  vendorId        String
  amount          Float
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  accountName     String?
  accountNumber   String
  adminNote       String?
  approvedAt      DateTime?
  paidAt          DateTime?
  rejectedAt      DateTime?
  rejectionReason String?
  transactionId   String?
  vendorNote      String?
  status          PayoutStatus @default(PENDING)
  cancelledAt     DateTime?
  processedById   String?
  paymentMethod   String
  vendor          Vendor       @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([vendorId])
  @@index([status])
  @@index([createdAt])
}

model FinanceTransaction {
  id          String                   @id @default(uuid())
  type        FinanceTransactionType
  amount      Float
  status      FinanceTransactionStatus @default(COMPLETED)
  referenceId String?
  description String?
  vendorId    String?
  userId      String?
  createdAt   DateTime                 @default(now())
  user        User?                    @relation(fields: [userId], references: [id])
  vendor      Vendor?                  @relation(fields: [vendorId], references: [id])

  @@index([type])
  @@index([vendorId])
  @@index([userId])
  @@index([createdAt])
}

model PageContent {
  id           String   @id @default(uuid())
  key          String   @unique
  title        String
  contentHtml  String
  sectionsJson String?
  updatedById  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([key])
  @@index([updatedAt])
}

model HeroSlide {
  id                  String   @id @default(uuid())
  title               String?
  subtitle            String?
  imageUrl            String
  imagePublicId       String?
  primaryButtonText   String
  primaryButtonUrl    String
  secondaryButtonText String?
  secondaryButtonUrl  String?
  isActive            Boolean  @default(true)
  displayOrder        Int      @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([isActive, displayOrder])
  @@index([displayOrder])
}

model PlatformSetting {
  id                     String         @id @default("GLOBAL")
  defaultCommissionType  CommissionType @default(PERCENTAGE)
  defaultCommissionValue Float          @default(0)
  heroAutoSlide          Boolean        @default(true)
  heroIntervalMs         Int            @default(5000)
  fullLogoUrl            String?
  fullLogoPublicId       String?
  headerLogoUrl          String?
  headerLogoPublicId     String?
  footerLogoUrl          String?
  footerLogoPublicId     String?
  dashboardLogoUrl       String?
  dashboardLogoPublicId  String?
  compactLogoUrl         String?
  compactLogoPublicId    String?
  faviconUrl             String?
  faviconPublicId        String?
  phone                  String?
  supportEmail           String?
  location               String?
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt
}

enum Role {
  SUPER_ADMIN
  ADMIN
  SUPPORT_AGENT
  VENDOR
  CUSTOMER
}

enum ContactChangePurpose {
  EMAIL_CHANGE
  PHONE_CHANGE
}

enum UserStatus {
  ACTIVE
  PENDING
  BLOCKED
}

enum VendorStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum ProductStatus {
  PENDING
  APPROVED
  REJECTED
  DRAFT
}

enum CommissionType {
  PERCENTAGE
  FIXED
}

enum FinanceTransactionType {
  ORDER_PAYMENT
  COMMISSION
  VENDOR_EARNING
  PAYOUT
  ADMIN_DEDUCTION
}

enum FinanceTransactionStatus {
  PENDING
  COMPLETED
  FAILED
  CANCELLED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  COMPLETED
  CANCELLED
  RETURNED
  REFUNDED
  PARTIALLY_CONFIRMED
  PARTIALLY_PROCESSING
  PARTIALLY_SHIPPED
  PARTIALLY_DELIVERED
  PARTIALLY_COMPLETED
  PARTIALLY_CANCELLED
}

enum OrderItemStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  CANCELLED
  DELIVERED
  COMPLETED
  RESHIPPED
}

enum ReturnStatus {
  NONE
  REQUESTED
  APPROVED
  REJECTED
  IN_TRANSIT
  RECEIVED
  RESHIPPED
  RESOLVED
}

enum PaymentMethod {
  COD
}

enum PaymentStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
}

enum TicketStatus {
  OPEN
  PENDING
  RESOLVED
  CLOSED
  IN_PROGRESS
  WAITING_FOR_CUSTOMER
  WAITING_FOR_STAFF
  ESCALATED
  REJECTED
}

enum TicketCategory {
  ORDER_ISSUE
  PAYMENT_ISSUE
  REFUND_REQUEST
  WITHDRAWAL_ISSUE
  ACCOUNT_ISSUE
  PRODUCT_ISSUE
  DELIVERY_ISSUE
  TECHNICAL_ISSUE
  VENDOR_ISSUE
  OTHER
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum SupportActivityType {
  TICKET_CREATED
  REPLY_ADDED
  INTERNAL_NOTE_ADDED
  ASSIGNED
  REASSIGNED
  PRIORITY_CHANGED
  STATUS_CHANGED
  ESCALATED
  RESOLVED
  CLOSED
  REOPENED
  REJECTED
  ATTACHMENT_ADDED
  RATING_ADDED
  ARCHIVED
}

enum AddressType {
  HOME
  OFFICE
  OTHER
}

enum PayoutStatus {
  PENDING
  APPROVED
  PAID
  REJECTED
  CANCELLED
}
